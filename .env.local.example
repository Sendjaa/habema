# ============================================================
# TEMPLATE ENVIRONMENT — DEVELOPMENT LOKAL
# Salin file ini menjadi .env.local, lalu isi nilainya:
#     cp .env.local.example .env.local
#
# Urutan prioritas Next.js (yang belakangan MENANG):
#     .env  <  .env.local
# .env.local selalu menang atas .env di SEMUA environment, termasuk
# saat `npm run build` / `npm start`. Karena itu: JANGAN pernah menaruh
# kredensial production di .env.local.
#
# Untuk nilai yang dipakai saat deploy, lihat .env.production.example.
#
# ------------------------------------------------------------
# STATUS DATABASE SAAT INI (per 24 Sep 2026)
# ------------------------------------------------------------
# Database dev dan production BELUM dipisah. Dev lokal masih menunjuk ke
# project Supabase yang sama dengan production:
#     project ref : ypbdqkfxtmkbllhezmqz  ("habamaOutdoor")
# Artinya `npm run dev` saat ini MENULIS KE DATABASE PRODUCTION —
# booking, order, dan notifikasi uji bercampur dengan data pelanggan asli.
#
# Saat project DB dev sudah tersedia, tukar tiga nilai ini saja di
# .env.local dengan kredensial DB dev:
#     NEXT_PUBLIC_SUPABASE_URL
#     NEXT_PUBLIC_SUPABASE_ANON_KEY
#     SUPABASE_SERVICE_ROLE_KEY
# Jangan sentuh .env (biarkan sebagai kredensial production).
# Langkah lengkapnya ada di DATABASE_ENV_SETUP.md.
# ============================================================


# ------------------------------------------------------------
# WAJIB — SUPABASE
# Ambil dari Supabase Dashboard -> Project Settings -> API
# Untuk dev, gunakan project DB dev (bukan production).
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-dev-anon-key-here

# Hanya untuk server. Jangan pernah dipakai di komponen client —
# key ini menembus Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-key-here


# ------------------------------------------------------------
# WAJIB (BERTAHAP) — POSTGRESQL LOKAL
# Dipakai lib/db/index.ts lewat driver `pg` + Drizzle. Hanya untuk kode
# server; jangan diimpor dari komponen 'use client'.
#
# Ini bagian dari migrasi bertahap keluar dari Supabase. Selama migrasi
# belum selesai, env Supabase di atas MASIH DIBUTUHKAN — alur yang belum
# dimigrasi tetap memakainya. Untuk dev lokal, DB-nya bisa diisi hasil
# salinan dari production (lihat scripts/dump-prod-db.mjs).
#
# Nama database & password sesuai yang Anda buat saat memasang PostgreSQL.
# ------------------------------------------------------------
POSTGRES_URL=postgresql://postgres:password-anda@localhost:5432/nama_database


# ------------------------------------------------------------
# WAJIB — ADMIN
# Email akun admin di Supabase Auth milik DB dev.
# ADMIN_EMAIL dibaca di server (middleware), NEXT_PUBLIC_ADMIN_EMAIL di client.
# Isi keduanya dengan email yang sama. Dukung banyak admin, pisahkan
# dengan koma: "admin@example.com, admin2@example.com"
# ------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com


# ------------------------------------------------------------
# WAJIB — URL APLIKASI
# NEXT_PUBLIC_BASE_URL  : callback Midtrans & link konfirmasi WhatsApp
# NEXT_PUBLIC_APP_URL   : metadata/canonical di app/layout.tsx
#                         (fallback kalau kosong: https://habema.biz.id)
# ------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ------------------------------------------------------------
# WAJIB — MIDTRANS
# Dev WAJIB pakai Sandbox. Key production tidak akan jalan di sandbox.
# Sandbox key diawali "SB-Mid-", production key diawali "Mid-".
#
# MIDTRANS_PRODUCTION          : dibaca di server (lib/midtrans.ts)
# NEXT_PUBLIC_MIDTRANS_PRODUCTION : dibaca di client untuk memilih script
#                                   Snap sandbox vs production
# Keduanya HARUS sama, kalau tidak popup Snap gagal dimuat.
#
# MIDTRANS_ALLOW_MOCK=true      : hanya berpengaruh saat MIDTRANS_PRODUCTION
#                                 false — mengizinkan API mengembalikan
#                                 respons pembayaran palsu kalau kredensial
#                                 belum diisi. JANGAN di-set true di production.
# ------------------------------------------------------------
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-YourSandboxClientKeyHere
MIDTRANS_SERVER_KEY=SB-Mid-server-YourSandboxServerKeyHere
MIDTRANS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_PRODUCTION=false
MIDTRANS_ALLOW_MOCK=true


# ------------------------------------------------------------
# WAJIB — CLOUDFLARE TURNSTILE (CAPTCHA login & register)
# https://dash.cloudflare.com/?to=/:account/turnstile
# Di dev lokal, Turnstile tetap aktif — pakai site key sandbox/test
# ("1x00000000000000000000AA") supaya captcha tidak menghalangi.
# ------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAA...
TURNSTILE_SECRET_KEY=0x4AAAA...


# ------------------------------------------------------------
# WAJIB — RESEND (email OTP login & register)
# https://resend.com
# ------------------------------------------------------------
RESEND_API_KEY=re_...
OTP_EMAIL_FROM=Habema <noreply@habema.com>


# ------------------------------------------------------------
# OPSIONAL — GOOGLE OAUTH
# Dipakai GoogleOAuthProviderWrapper di app/layout.tsx.
# Di Google Cloud Console, daftarkan Authorized redirect URI dev:
#     http://localhost:3000
# ------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com


# ------------------------------------------------------------
# OPSIONAL — GOOGLE MAPS (perhitungan jarak pengiriman)
# Enable Distance Matrix API di https://console.cloud.google.com/
# Kalau kosong, app jatuh ke fallback Leaflet + OSM + OSRM.
# ------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here


# ------------------------------------------------------------
# OPSIONAL — RAJA ONGKIR (ongkos kirim & tracking)
# https://rajaongkir.com/dashboard
# API Shipping Cost selalu live — tidak ada mode sandbox.
# Kalau kosong, lib/rajaongkir.ts melempar error saat dipanggil.
# ------------------------------------------------------------
RAJAONGKIR_API_KEY=your-rajaongkir-api-key-here


# ------------------------------------------------------------
# CATATAN
# ------------------------------------------------------------
# - Leaflet + OpenStreetMap + OSRM tidak butuh API key:
#     Nominatim (geocoding) : https://nominatim.openstreetmap.org
#     OSRM (routing)        : https://router.project-osrm.org
# - NEXT_PUBLIC_GOOGLE_SECRET dan NEXT_PUBLIC_REDIRECT_URI TIDAK dibaca
#   kode mana pun. Jangan ditambahkan ke file baru — Google OAuth di app
#   ini hanya perlu NEXT_PUBLIC_GOOGLE_CLIENT_ID.
# - Jangan pernah commit .env / .env.local. Yang di-commit hanya file
#   *.example seperti ini.
