# Midtrans Configuration
# Untuk development/testing, gunakan Sandbox keys dari Midtrans Dashboard
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-YourSandboxClientKeyHere
MIDTRANS_SERVER_KEY=SB-Mid-server-YourSandboxServerKeyHere
MIDTRANS_PRODUCTION=false

# Base URL untuk callbacks (sesuaikan dengan environment)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase (jika sudah ada)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps API (Untuk perhitungan jarak yang akurat)
# Daftar di: https://console.cloud.google.com/
# Enable API: Distance Matrix API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Leaflet + OpenStreetMap + OSRM (Fallback jika Google Maps tidak tersedia)
# Menggunakan OpenStreetMap untuk peta dan OSRM untuk routing
# API yang digunakan:
# - Nominatim (OpenStreetMap Geocoding): https://nominatim.openstreetmap.org
# - OSRM Routing: https://router.project-osrm.org

# Development notes:
# 1. Daftar akun Midtrans di https://dashboard.midtrans.com/
# 2. Pilih Environment: Sandbox untuk development
# 3. Copy Client Key dan Server Key ke atas
# 4. Untuk production, ganti MIDTRANS_PRODUCTION=true dan gunakan production keys
# 5. Untuk Google Maps API:
#    - Buat project di Google Cloud Console
#    - Enable Distance Matrix API
#    - Buat API Key dengan restriction
#    - Copy API key ke NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
