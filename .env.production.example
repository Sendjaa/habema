# ============================================================
# TEMPLATE ENVIRONMENT — PRODUCTION
#
# File ini hanya TEMPLATE. Jangan simpan kredensial production di repo.
#
# Cara pakai:
#   - Vercel (cara yang dipakai sekarang): set satu per satu di
#     Dashboard -> Project -> Settings -> Environment Variables,
#     scope "Production". Atau lewat CLI:
#         vercel env add NEXT_PUBLIC_SUPABASE_URL production
#   - Tanpa Vercel: salin jadi .env.production di server build, dan
#     pastikan file itu TIDAK ikut ter-commit (sudah di-ignore .gitignore).
#
# Ingat: .env.local selalu menang atas .env.production. Kalau di mesin
# build ada .env.local, nilainya yang dipakai — hapus dulu sebelum build.
# ============================================================


# ------------------------------------------------------------
# SUPABASE PRODUCTION
# Ambil dari Dashboard project production -> Settings -> API
# Project production saat ini: ypbdqkfxtmkbllhezmqz ("habamaOutdoor")
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://ypbdqkfxtmkbllhezmqz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-production-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key


# ------------------------------------------------------------
# ADMIN
# Harus email admin yang benar-benar ada di Supabase Auth production.
# ------------------------------------------------------------
ADMIN_EMAIL=admin@habema.biz.id
NEXT_PUBLIC_ADMIN_EMAIL=admin@habema.biz.id


# ------------------------------------------------------------
# URL APLIKASI
# ------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=https://habema.biz.id
NEXT_PUBLIC_APP_URL=https://habema.biz.id


# ------------------------------------------------------------
# MIDTRANS PRODUCTION
# Key production diawali "Mid-" (sandbox diawali "SB-Mid-").
# Transaksi nyata — salah set di sini berarti pembayaran asli gagal.
# Daftarkan juga callback URL di dashboard Midtrans:
#     Finish : https://habema.biz.id/payment/finish
#     Error  : https://habema.biz.id/payment/error
#     Pending: https://habema.biz.id/payment/pending
# ------------------------------------------------------------
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxx
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxx
MIDTRANS_PRODUCTION=true
NEXT_PUBLIC_MIDTRANS_PRODUCTION=true

# JANGAN di-set true di production. Biarkan kosong.
# Kalau true, API bisa mengembalikan respons pembayaran palsu saat
# kredensial Midtrans tidak terbaca — order tercatat lunas tanpa uang masuk.
MIDTRANS_ALLOW_MOCK=false


# ------------------------------------------------------------
# TURNSTILE / RESEND / GOOGLE / MAPS / RAJA ONGKIR
# Pakai key production masing-masing (bukan key dev/sandbox).
# ------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAA...
TURNSTILE_SECRET_KEY=0x4AAAA...
RESEND_API_KEY=re_...
OTP_EMAIL_FROM=Habema <noreply@habema.com>
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
RAJAONGKIR_API_KEY=your-rajaongkir-api-key-here
